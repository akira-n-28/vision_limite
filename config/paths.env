# Percorsi del progetto su Lagrange: TUTTO sotto /home/prignano/vision_limite.
# Caricare con:  source config/paths.env
# Le cartelle pesanti (data, hf, wheels, tools, venvs, cache, outputs, secrets) sono escluse da git
# con .gitignore. Nessun segreto in questo file.
export PROJECT_ROOT=/home/prignano/vision_limite
export DATA_ROOT=$PROJECT_ROOT/data
export OUTPUT_ROOT=$PROJECT_ROOT/outputs
export CHECKPOINT_ROOT=$PROJECT_ROOT/outputs/checkpoints
export CACHE_ROOT=$PROJECT_ROOT/cache
export WHEELHOUSE=$PROJECT_ROOT/wheels
export TOOLS_DIR=$PROJECT_ROOT/tools
export VENVS_DIR=$PROJECT_ROOT/venvs
export ENV_ROOT=$PROJECT_ROOT/venvs/current          # link al build adottato (venvs/build-<jobid>)
export RUN_PYTHON=$PROJECT_ROOT/venvs/current/bin/python

# Cache Hugging Face con le revisioni fissate (layout standard: hub/<tipo>--<org>--<nome>/...)
export HF_HOME=$PROJECT_ROOT/hf
export HF_TOKEN_FILE=$PROJECT_ROOT/secrets/hf_token  # facoltativo; cartella 700, file 600

# Nei job di calcolo: sempre offline, nessun download automatico.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1

# Cache di librerie in percorsi espliciti del progetto
export TRITON_CACHE_DIR=$CACHE_ROOT/triton
export TORCHINDUCTOR_CACHE_DIR=$CACHE_ROOT/inductor
export VLLM_CACHE_ROOT=$CACHE_ROOT/vllm
export XDG_CACHE_HOME=$CACHE_ROOT/xdg
export UV_CACHE_DIR=$CACHE_ROOT/uv
export PIP_CACHE_DIR=$CACHE_ROOT/pip
export TMPDIR_PROJECT=$CACHE_ROOT/tmp
